# ===== Vera Practice — переменные окружения =====
# Файл необязательный и нужен в основном для разработки.
# Ключ AI-провайдера обычно сюда НЕ пишут: при первом запуске start.cmd
# сам попросит его и сохранит в data/settings.json зашифрованным под
# учётную запись Windows. Этот шаблон лежит в git — никаких значений
# секретов в нём быть не должно; копия с ключом называется .env и в git
# не попадает (.gitignore).
#
# Приоритет источников ключа: сохранённый при установке (data/settings.json)
# → переменные окружения → .env.local → .env

# ---------- AI-провайдер ----------

# OpenAI-совместимый базовый URL провайдера (без хвостового слэша)
AI_BASE_URL=https://api.proxyapi.ru/v1

# Разрешённые HTTPS-hosts провайдера через запятую. Не добавляйте внутренние адреса.
AI_ALLOWED_HOSTS=api.proxyapi.ru

# Ключ API провайдера — только для разработки и только в .env, не в этом шаблоне.
# В обычной установке оставьте пустым: start.cmd спросит ключ при первом запуске.
AI_API_KEY=

# Модели (проверены на proxyapi.ru; меняйте при смене провайдера)
AI_CHAT_MODEL=mistralai/mistral-small-3.2-24b-instruct # дешёвый генератор сцен и «актёр»-пациент
AI_EVAL_MODEL=openai/gpt-4o-mini                       # AI-оценщик; менять только с прогоном npm run regression
AI_TTS_MODEL=openai/gpt-4o-mini-tts                    # озвучка собеседника
AI_STT_MODEL=openai/gpt-4o-mini-transcribe             # распознавание речи студента

# ---------- Аккаунты и доступ ----------

# Код запуска: нужен один раз, чтобы создать первый аккаунт преподавателя
# на экране «Первый запуск преподавателя». Без него bootstrap отключён.
ADMIN_PASSWORD=

# Лимит платных обращений к провайдеру на нового студента.
# Короткая сцена ≈ 7 единиц (1 генерация + 2 реплики + до 3 распознаваний + 1 разбор),
# полный приём ≈ 25. Преподаватель меняет лимит поштучно в кабинете.
DEFAULT_REQUEST_QUOTA=200

# Ставить ли флаг Secure на cookie входа принудительно. По умолчанию флаг
# определяется по протоколу запроса: по HTTP в локальной сети кафедры он
# выключен (иначе браузер выбросил бы cookie и войти было бы нельзя),
# по HTTPS — включён. Ставьте 1, только если сервис всегда за HTTPS.
# FORCE_SECURE_COOKIE=1

# ---------- Сцены ----------

# Ответов студента в короткой сцене (макс. 4)
DIALOG_EXCHANGES=3

# Ответов студента в полной консультации «регистратура → выписка» (6..20)
LONG_EXCHANGES=12

# Лимит одной голосовой записи, секунды (10..120)
RECORD_MAX_SECONDS=45

# ---------- Сервер ----------

PORT=3000

# Папка данных (БД, кэш озвучки, настройки). По умолчанию ./data
DATA_DIR=data
