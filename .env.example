# ===== Vera Practice — переменные окружения =====
# Файл необязательный: при первом запуске ключ можно ввести прямо в приложении —
# он сохранится в data/settings.json (папка в .gitignore) и будет иметь приоритет
# над этим файлом. Копируйте .env, только если удобнее держать ключ здесь.
#
# Приоритет источников: data/settings.json → .env.local → .env → process.env

# OpenAI-совместимый базовый URL провайдера (без хвостового слэша)
AI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Ключ API провайдера. Можно оставить пустым и ввести через экран «Подключение».
AI_API_KEY=

# Модели (проверены на proxyapi.ru; меняйте при смене провайдера)
AI_CHAT_MODEL=gpt-4o-mini          # генератор сценариев и «актёр»-пациент
AI_EVAL_MODEL=gpt-4o-mini            # AI-оценщик (компромисс: детерминированный и дешёвый)
AI_TTS_MODEL=gpt-4o-mini-tts        # озвучка пациента
AI_STT_MODEL=gpt-4o-mini-transcribe # распознавание речи врача

# HTTP
PORT=3000

# Сколько обменов «реплика врача → ответ пациента» после открывающей жалобы (макс. 4)
DIALOG_EXCHANGES=3

# Лимиты записи голоса, секунды
RECORD_MAX_SECONDS=60

# Папка данных (БД + кэш TTS). По умолчанию ./data относительно корня проекта
DATA_DIR=data
